# syntax=docker/dockerfile:1
# Cloud Run production image — the same application as ./Dockerfile (used by
# docker-compose for local dev), built for Cloud Run's constraints instead:
#   - listens on $PORT (Cloud Run assigns it at runtime; app.server falls back
#     to 8000 if unset, matching the compose image, so nothing else changes)
#   - no dev hot-reload
#   - non-root, no PyTorch (ADR 0004), no GPU required
#   - installs the optional `s3` extra so STORAGE_BACKEND=s3 (Cloudflare R2 is
#     S3-compatible) works without a second install step
#   - pre-downloads the embedding + reranker ONNX models into the image so a
#     fresh instance after scale-to-zero doesn't fetch ~150MB before serving
#     its first request
#
# This file does not replace ./Dockerfile and is not used by docker-compose.
# See docs/DEPLOYMENT.md for the full deploy flow.

FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first, for layer caching.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra s3

# Then the project itself.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra s3

# Pre-download the default embedding + reranker ONNX models into the image.
# Override these build args if the deployment's EMBEDDING_MODEL / RERANKER_MODEL
# env vars differ — they must match exactly, or the cache still misses at
# runtime and the instance falls back to downloading on first use.
ARG EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ARG RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ENV FASTEMBED_CACHE_PATH=/opt/model-cache \
    HF_HOME=/opt/model-cache
RUN /app/.venv/bin/python -c "\
from fastembed import TextEmbedding; \
from fastembed.rerank.cross_encoder import TextCrossEncoder; \
TextEmbedding(model_name='${EMBEDDING_MODEL}'); \
TextCrossEncoder(model_name='${RERANKER_MODEL}')"


FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    FASTEMBED_CACHE_PATH=/opt/model-cache \
    HF_HOME=/opt/model-cache

RUN groupadd --system app && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --from=builder --chown=app:app /opt/model-cache /opt/model-cache
COPY --chown=app:app app ./app
COPY --chown=app:app alembic ./alembic
COPY --chown=app:app alembic.ini pyproject.toml ./
# No /data volume: Cloud Run's container filesystem is ephemeral per-instance,
# and the app is otherwise stateless — uploaded documents go to object storage
# (STORAGE_BACKEND=s3 against Cloudflare R2), not local disk.

USER app
EXPOSE 8080

# Cloud Run injects $PORT (8080 by convention). app.server.main() reads it —
# see ./Dockerfile / app/server.py; no port is hardcoded here.
CMD ["python", "-m", "app.server"]
