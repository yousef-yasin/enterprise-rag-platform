# enterprise-rag-platform — example environment.
#
# Everything here has a safe local default; docker compose works with NO .env
# file. Copy to `.env` and edit only what you need. Secrets: never commit `.env`.
#
# Namespaces: APP_ AUTH_ / JWT_  LLM_  EMBEDDING_  RERANKER_  RETRIEVAL__*
#             CHUNK_ INGEST/limits  POSTGRES_  QDRANT_  REDIS_  STORAGE_
#             CORS_ RATE_LIMIT_ EVAL_

# ── App ──────────────────────────────────────────────────────────────────────
APP_PROFILE=local                 # local | prod | ci | test  (ci/test allow fake providers)
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
BIND_HOST=127.0.0.1               # single_user auth mode requires a loopback bind

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_MODE=multi_user              # multi_user | single_user
JWT_SECRET=change-me-in-production-please-32chars-min   # REQUIRED to change for prod
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
ALLOW_OPEN_REGISTRATION=false     # true = anyone can self-register
BOOTSTRAP_ADMIN_EMAIL=            # set to auto-create the first admin on bootstrap
BOOTSTRAP_ADMIN_PASSWORD=         # omit to have one generated and printed once
# APP_TOKEN=                      # single_user mode only: required on every API call

# Refresh-token cookie + CSRF (§24.2). The access token stays in browser memory;
# the refresh token is an HttpOnly cookie with a CSRF double-submit companion.
SESSION_COOKIE_SECURE=false       # MUST be true behind HTTPS (enforced for APP_PROFILE=prod)
SESSION_COOKIE_SAMESITE=lax       # lax | strict | none  (none needs SECURE=true)
# SESSION_COOKIE_DOMAIN=          # set only if the API and UI are on different subdomains

# ── LLM (generation) ─────────────────────────────────────────────────────────
LLM_PROVIDER=openai               # openai | anthropic | ollama | fake(ci/test only)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=                      # REQUIRED for openai/anthropic — fails fast if missing
LLM_BASE_URL=                     # REQUIRED for ollama, e.g. http://ollama:11434
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=60
# LLM_FALLBACK_PROVIDER=          # optional pre-first-token fallback (§17.3)
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_API_KEY=

# ── Embeddings (local ONNX by default — no torch, no GPU) ─────────────────────
EMBEDDING_PROVIDER=fastembed      # fastembed | openai | ollama | fake(ci/test only)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_API_KEY=              # openai embeddings; falls back to LLM_API_KEY
# EMBEDDING_BASE_URL=             # ollama embeddings
EMBEDDING_MAX_BATCH=64
# NOTE: EMBEDDING_FALLBACK_* is intentionally unsupported (§17). A profile change
# means a full KB reindex, not a silent swap.

# ── Reranker ─────────────────────────────────────────────────────────────────
RERANKER=fastembed_cross_encoder  # fastembed_cross_encoder | none | cohere | jina
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANKER_API_KEY=               # cohere / jina only

# ── Retrieval tuning (nested — double underscore) ────────────────────────────
RETRIEVAL__FUSION_STRATEGY=rrf    # rrf | weighted_norm | dbsf
RETRIEVAL__DENSE_TOP_K=50
RETRIEVAL__SPARSE_TOP_K=50
RETRIEVAL__RERANK_INPUT_K=40
RETRIEVAL__RERANK_OUTPUT_K=8
RETRIEVAL__RERANK_TIMEOUT_MS=1500
RETRIEVAL__QUERY_REWRITE_ENABLED=true
RETRIEVAL__ABSTAIN_ON_EMPTY=true

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_FRACTION=0.15

# ── Ingestion limits ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_PAGES=1500
MAX_CHUNKS_PER_DOC=5000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev
POSTGRES_DB=rag

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant_local_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_dev
REDIS_DB=0

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local             # local | s3
STORAGE_LOCAL_PATH=/data/uploads
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# ── HTTP / ops ───────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=40
METRICS_ENABLED=true
TRUSTED_PROXIES=127.0.0.1,::1

# ── Evaluation ───────────────────────────────────────────────────────────────
EVAL_BOOTSTRAP_N=1000
# EVAL_JUDGE_PROVIDER=            # defaults to LLM_PROVIDER; use a different family
# EVAL_JUDGE_MODEL=
# EVAL_JUDGE_API_KEY=
# EVAL_DATASET_ROOT=             # override the repo-root eval/datasets path
SEED_ON_BOOTSTRAP=false
